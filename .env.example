# Required: pybind build produced from sts_lightspeed + sim_patch/sim_rl_hooks.patch
STS_LIGHTSPEED_BUILD=/absolute/path/to/sts_lightspeed/build312
# Legacy training/evaluation scripts expect a workspace containing sim/sts_lightspeed.
STS_BOT_DIR=/absolute/path/to/sts-bot-workspace

# A20-to-Heart development policy (agent/armG_train.py also defaults to 20)
ASC=20

# Optional live-run settings
STS_PYTHON=python3
STS_LIVE_POLICY=learned
STS_SEED=620908546
STS_SEED_TOKEN=BTRU46
STS_NEOW_INDEX=3
STS_MCTS_SIMULATIONS=2000
STS_MCTS_DETERMINIZATIONS=1
STS_MCTS_UNSUPPORTED=fail
STS_LIVE_LOG=./runs/learned-seed-620908546.jsonl

# Optional macOS paths used by steam/state_export_mod/build.sh
# STS_GAME_RESOURCES=/absolute/path/to/SlayTheSpire.app/Contents/Resources
# STS_MODTHESPIRE_JAR=/absolute/path/to/ModTheSpire.jar
