+                    bestOrder = order;
+                    preferred.clear();
+                }
+                if (order == bestOrder) preferred.push_back(i);
+            }
+            selectedIdx = preferred[std::uniform_int_distribution<int>(
+                0, static_cast<int>(preferred.size()) - 1)(randGen)];
+        }
