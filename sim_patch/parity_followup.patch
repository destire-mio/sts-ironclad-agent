+
+void BattleContext::onUseCardRelics() {
+    auto &p = player;
+    const auto &item = curCardQueueItem;
+    const auto &c = item.card;
+    const auto type = c.getType();
+    const bool attack = type == CardType::ATTACK;
+    const bool skill = type == CardType::SKILL;
+    const bool power = type == CardType::POWER;
+
+    // UseCardAction dispatches relic callbacks in acquisition order. Queueing
+    // draws before/after Orange Pellets changes card costs and RNG consumption.
+    for (const auto relic : p.cardUseRelics) {
+        switch (relic) {
+            case R::INK_BOTTLE:
+                if (++p.inkBottleCounter == 10) {
+                    p.inkBottleCounter = 0;
+                    addToBot(Actions::DrawCards(1));
+                }
+                break;
+            case R::ORANGE_PELLETS:
+                if (attack || skill || power) {
+                    p.orangePelletsCardTypesPlayed.set(static_cast<int>(type), true);
+                    if (p.orangePelletsCardTypesPlayed.all()) {
+                        p.orangePelletsCardTypesPlayed.reset();
+                        addToBot(Actions::RemovePlayerDebuffs());
+                    }
+                }
+                break;
+            case R::KUNAI:
+                if (attack && p.attacksPlayedThisTurn % 3 == 0)
+                    addToBot(Actions::BuffPlayer<PS::DEXTERITY>(1));
+                break;
+            case R::ORNAMENTAL_FAN:
+                if (attack && p.attacksPlayedThisTurn % 3 == 0)
+                    addToBot(Actions::GainBlock(4));
+                break;
+            case R::SHURIKEN:
+                if (attack && p.attacksPlayedThisTurn % 3 == 0)
+                    addToBot(Actions::BuffPlayer<PS::STRENGTH>(1));
+                break;
+            case R::NECRONOMICON:
+                // Autoplay skips energy payment but does not set freeToPlayOnce.
+                // The original X-cost branch checks energyOnUse independently.
+                if (attack && !p.haveUsedNecronomiconThisTurn &&
+                    ((c.costForTurn >= 2 && !c.freeToPlayOnce) ||
+                     (c.isXCost() && item.energyOnUse >= 2))) {
+                    queuePurgeCard(c, item.target);
+                    p.haveUsedNecronomiconThisTurn = true;
+                }
+                break;
+            case R::PEN_NIB:
+                if (attack && ++p.penNibCounter == 9) {
+                    addToBot(Actions::BuffPlayer<PS::PEN_NIB>(1));
+                    p.penNibCounter = -1;
+                }
+                break;
+            case R::DUALITY:
+                if (attack) addToBot(Actions::DualityAction());
+                break;
+            case R::NUNCHAKU:
+                if (attack && ++p.nunchakuCounter >= 10) {
+                    addToBot(Actions::GainEnergy(1));
+                    p.nunchakuCounter = 0;
+                }
+                break;
+            case R::LETTER_OPENER:
+                if (skill && p.skillsPlayedThisTurn % 3 == 0)
+                    addToBot(Actions::DamageAllEnemy(5));
+                break;
+            case R::BIRD_FACED_URN:
+                if (power) p.heal(2);
+                break;
+            case R::MUMMIFIED_HAND:
+                if (power) mummifiedHandOnUsePower();
+                break;
+            default:
+                break;
+        }
+    }
 }
 
